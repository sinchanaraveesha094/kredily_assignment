      "name": "1. Auth - Login",
      "item": [
        {
          "name": "POS - valid login returns token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responds in < 3s', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "const j = pm.response.json();",
                  "pm.test('Token returned', () => pm.expect(JSON.stringify(j)).to.match(/token/i));",
                  "// store token: adjust the path to match the captured response, e.g. j.data.token",
                  "const tok = j.token || (j.data && j.data.token) || (j.data && j.data.access_token) || j.access_token;",
                  "if (tok) pm.collectionVariables.set('token', tok);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/enduser/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "enduser",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "NEG - wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejected with 4xx', () => pm.expect(pm.response.code).to.be.within(400,422));",
                  "pm.test('No token in response', () => pm.expect(pm.response.text()).to.not.match(/\"(access_)?token\"\\s*:\\s*\"[^\"]+\"/i));",
                  "pm.test('Error message present', () => pm.expect(pm.response.text().length).to.be.above(2));"
                ]
